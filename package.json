{
  "name": "sahne",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Code-first educational motion graphics",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts SahneDemo out/sahne-demo.mp4",
    "render:example": "remotion render src/index.ts SahneDemo out/sahne-demo.mp4 --props=./examples/demo.json",
    "compositions": "remotion compositions src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "remotion": "4.0.540",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.540",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
